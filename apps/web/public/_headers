# Cloudflare Workers の静的ファイルに付けるヘッダー。
# NIP-05 の本人確認は、ほかのクライアントがブラウザから読むので、どこからでも読めるようにする。
/.well-known/nostr.json
  Access-Control-Allow-Origin: *
  Access-Control-Allow-Methods: GET, OPTIONS
  Access-Control-Allow-Headers: *

# ファイル名に中身のハッシュが付いているので、変わるときは名前ごと変わる。
# 確かめに行かせず、次に開いたときもそのまま使わせる。
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# 絵文字を作るときの文字の輪郭。`v1` の中身は変えない（変えるときは v2 を足す）。
/emoji-glyphs/v1/*
  Cache-Control: public, max-age=31536000, immutable
