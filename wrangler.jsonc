{
  "name": "streets",
  "main": "./workers/app/src/index.ts",
  "compatibility_date": "2026-09-20",
  // 版ごと・PR ごとのプレビュー URL（…workers.dev）を使う。本番は独自ドメイン。
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": "./apps/web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Worker を通すのは API だけ。画面の配信は今までどおり静的ファイルから直接返す。
    "run_worker_first": ["/api/*"]
  },
  "ratelimits": [
    {
      // リンクのカードを外へ取りに行く回数（IP ごと）。キャッシュに当たった分は数えない。
      "name": "LINK_CARD_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 60, "period": 60 }
    }
  ]
}
