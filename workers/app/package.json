{
  "devDependencies": {
    "typescript": "5.7.3",
    "vitest": "4.1.11",
    "wrangler": "4.135.0"
  },
  "name": "@streets/app-worker",
  "private": true,
  "scripts": {
    "dev": "node -e \"require('node:fs').mkdirSync('../../apps/web/dist', { recursive: true })\" && wrangler dev --config ../../wrangler.jsonc --port 8787",
    "test": "vitest run",
    "typecheck": "wrangler types --check --config ../../wrangler.jsonc worker-configuration.d.ts && tsc --noEmit",
    "types": "wrangler types --config ../../wrangler.jsonc worker-configuration.d.ts"
  },
  "type": "module",
  "dependencies": {
    "@hono/valibot-validator": "0.6.1",
    "hono": "4.13.8",
    "valibot": "1.4.1"
  }
}
