{
  "name": "solid-template",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build",
    "check": "biome check . && pnpm run check:read-layer",
    "check:read-layer": "node scripts/check-read-layer-deps.mjs",
    "typecheck": "tsc -b",
    "verify": "pnpm run check && pnpm run typecheck && vitest run && vite build && pnpm run storybook:build",
    "verify:all": "pnpm run verify && playwright test",
    "fix": "biome check --write .",
    "fix:force": "biome check --write --unsafe .",
    "test": "vitest",
    "mutation": "stryker run",
    "e2e": "playwright test",
    "e2e:seed": "tsx e2e/fixtures/seed.ts",
    "e2e:seed:outbox": "tsx e2e/fixtures/seed-outbox.ts",
    "dev:relay:wait": "node scripts/wait-for-relays.mjs",
    "dev:relay:reset": "node scripts/reset-local-relay-db.mjs",
    "dev:relay:inspect": "node scripts/inspect-local-relay.mjs",
    "dev:relay:publish": "node scripts/publish-test-note.mjs",
    "seed:dev": "node scripts/seed-dev-threads.mjs",
    "analyze": "pnpm dlx vite-bundle-visualizer -o .stats.html",
    "check-unused": "pnpm dlx @line/ts-remove-unused --skip 'src/index.tsx' --check --project tsconfig.app.json"
  },
  "dependencies": {
    "@ark-ui/solid": "5.38.1",
