{
  "name": "streets",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vp run -r --parallel dev",
    "build": "vp run @streets/web#build",
    "storybook": "vp run @streets/web#storybook",
    "test": "node --test scripts/*.test.mjs",
    "verify": "vp check && vp run knip && vp run -r types:check && vp run -r test && vp run build",
    "knip": "knip",
    "dev:relay:wait": "node scripts/wait-for-relays.mjs",
    "dev:relay:reset": "node scripts/reset-local-relay-db.mjs",
    "dev:relay:inspect": "node scripts/inspect-local-relay.mjs",
    "dev:relay:publish": "node scripts/publish-test-note.mjs",
    "seed:dev": "node scripts/seed-dev-threads.mjs",
    "e2e": "vp run @streets/e2e#test:e2e",
    "screenshot": "vp run @streets/screenshot#start",
    "screenshot:seed": "vp run @streets/screenshot#seed",
    "screenshot:generate": "vp run @streets/screenshot#generate",
    "ja:extract": "node scripts/ja-text-extract.mjs",
    "ja:apply": "node scripts/ja-text-apply.mjs",
    "prepare": "vp config"
  },
  "devDependencies": {
    "@noble/curves": "^2.4.0",
    "@noble/hashes": "^2.4.0",
    "@types/node": "24",
    "knip": "6.38.0",
    "nostr-tools": "2.25.2",
    "ts-morph": "^28.0.0",
    "typescript": "7.0.2",
    "vite-plus": "catalog:",
    "wrangler": "4.137.0"
  },
  "packageManager": "pnpm@12.6.0"
}
