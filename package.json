{
  "name": "streets",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @streets/web dev",
    "build": "pnpm --filter @streets/web build",
    "check": "biome check .",
    "fix": "biome check --write .",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "verify": "pnpm run check && pnpm run typecheck && pnpm run test && pnpm run build",
    "dev:relay:wait": "node scripts/wait-for-relays.mjs",
    "dev:relay:reset": "node scripts/reset-local-relay-db.mjs",
    "dev:relay:inspect": "node scripts/inspect-local-relay.mjs",
    "dev:relay:publish": "node scripts/publish-test-note.mjs",
    "seed:dev": "node scripts/seed-dev-threads.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@noble/curves": "^2.2.0",
    "@noble/hashes": "^2.2.0",
    "@types/node": "22",
    "nostr-tools": "2.10.4",
    "typescript": "5.7.3"
  },
  "packageManager": "pnpm@9.7.0+sha512.dc09430156b427f5ecfc79888899e1c39d2d690f004be70e05230b72cb173d96839587545d09429b55ac3c429c801b4dc3c0e002f653830a420fa2dd4e3cf9cf"
}
