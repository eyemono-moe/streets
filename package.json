    "@neodrag/solid": "2.3.0",
    "@noble/ciphers": "0.5.3",
    "@noble/curves": "^2.2.0",
    "@noble/hashes": "^2.2.0",
    "@rust-nostr/nostr-sdk": "0.39.0",
    "@scure/base": "^2.2.0",
    "@sentry/solid": "9.1.0",
    "@solid-primitives/autofocus": "0.1.0",
    "@solid-primitives/event-listener": "2.4.0",
    "@solid-primitives/i18n": "2.2.0",
    "@solid-primitives/intersection-observer": "2.2.0",
    "@solid-primitives/media": "2.3.0",
    "@solid-primitives/memo": "1.4.0",
    "@solid-primitives/presence": "0.1.0",
    "@solid-primitives/refs": "1.1.0",
    "@solid-primitives/resize-observer": "2.1.0",
    "@solid-primitives/scheduled": "1.5.0",
    "@solidjs/router": "0.13.6",
    "@tanstack/solid-query": "5.100.10",
    "@tanstack/solid-query-devtools": "5.100.10",
    "@tanstack/solid-virtual": "3.13.0",
    "@thisbeyond/solid-dnd": "0.7.5",
    "@unocss/reset": "65.5.0",
    "bech32": "2.0.0",
    "blurhash": "2.0.5",
    "browser-image-compression": "2.0.2",
    "cropperjs": "1.6.2",
    "emoji-mart": "5.6.0",
    "fuse.js": "7.1.0",
    "linkifyjs": "4.2.0",
    "nostr-tools": "2.10.4",
    "rx-nostr": "3.5.0",
    "rx-nostr-crypto": "3.1.3",
    "rxjs": "7.8.1",
    "safe-stable-stringify": "2.5.0",
    "solid-js": "1.9.13",
    "text-field-edit": "4.1.1",
